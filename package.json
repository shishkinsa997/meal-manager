{
  "name": "meal-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=4000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.0",
    "eslint": "^10.0.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "prettier": "3.7.4",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "modern-normalize": "^3.0.1",
    "tailwindcss": "^4.2.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
